#!/bin/sh
# /usr/lib/os-release belongs to Debian's base-files. A derivative that simply
# ships its own copy makes dpkg refuse the install ("trying to overwrite ...
# which is also in package base-files"), and forcing it would leave two
# packages fighting over one path on every base-files upgrade.
#
# The supported way to take a file over from another package is to divert it.
# Debian's file is kept, under a new name, and comes back untouched when this
# package is removed.
set -e

case "$1" in
install | upgrade)
	dpkg-divert --package b1nix-base-files --add --rename \
		--divert /usr/lib/os-release.debian /usr/lib/os-release
	;;
abort-upgrade) ;;
esac

#DEBHELPER#

exit 0
