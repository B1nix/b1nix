#!/usr/bin/make -f
# Three packages, no compilation: identification and configuration
# (b1nix-base-files), a dependency list (b1nix-desktop) and one script
# (b1nix-tools).
#
# The values that differ per release live in debian/b1nix-subst, written by
# tools/deb/build-deb.sh when it renders this source package. Rendering
# happens here rather than there so that `dpkg-buildpackage` on an unpacked
# source tree produces the same packages as the script does.

SUBST          := debian/b1nix-subst
DISTRO_RELEASE := $(shell sed -n 's/^DISTRO_RELEASE=//p' $(SUBST))
CODENAME       := $(shell sed -n 's/^CODENAME=//p' $(SUBST))
CODENAME_UI    := $(shell sed -n 's/^CODENAME_UI=//p' $(SUBST))
KERNEL_RELEASE := $(shell sed -n 's/^KERNEL_RELEASE=//p' $(SUBST))
REPO_URL       := $(shell sed -n 's|^REPO_URL=||p' $(SUBST))
REPO_SUITE     := $(shell sed -n 's/^REPO_SUITE=//p' $(SUBST))

%:
	dh $@

override_dh_auto_build:
	mkdir -p out
	sed -e 's|@DISTRO_RELEASE@|$(DISTRO_RELEASE)|g' \
	    -e 's|@CODENAME@|$(CODENAME)|g' \
	    -e 's|@CODENAME_UI@|$(CODENAME_UI)|g' \
	    -e 's|@KERNEL_RELEASE@|$(KERNEL_RELEASE)|g' \
	    files/os-release.in >out/os-release
	sed -e 's|@REPO_URL@|$(REPO_URL)|g' \
	    -e 's|@REPO_SUITE@|$(REPO_SUITE)|g' \
	    files/b1nix.sources.in >out/b1nix.sources

override_dh_auto_install:
	# ── b1nix-base-files ────────────────────────────────────────────────
	# /usr/lib/os-release only: /etc/os-release is already a symlink to it,
	# shipped by Debian's base-files, and shipping a second one would be the
	# same file conflict the preinst diverts around.
	install -D -m 0644 out/os-release debian/b1nix-base-files/usr/lib/os-release
	install -D -m 0644 out/b1nix.sources \
		debian/b1nix-base-files/etc/apt/sources.list.d/b1nix.sources
	install -D -m 0644 files/b1nix-kernel.pref \
		debian/b1nix-base-files/etc/apt/preferences.d/b1nix-kernel
	install -D -m 0644 files/README.keyring \
		debian/b1nix-base-files/usr/share/doc/b1nix-base-files/README.keyring
	install -d debian/b1nix-base-files/etc/apt/keyrings
	# ── b1nix-tools ─────────────────────────────────────────────────────
	install -D -m 0755 files/b1nix-report debian/b1nix-tools/usr/bin/b1nix-report

override_dh_auto_clean:
	rm -rf out
