#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# INSTALL-SMOKE's in-guest half: install b1nix onto the first disk with
# b1nix-install, unattended, and report how it went. Runs only when the kernel
# command line says b1nix.install-smoke, like the other lanes' checks.
#
# The installer gets the answers a person would type, from a file; its log and
# the verdict go to the 9p share the lane passes in, as well as to the console.
set -u
say() { printf 'INSTALL-SMOKE: %s\n' "$*" >/dev/console; }
SHARE=/run/install-smoke
mkdir -p "$SHARE"
mount -t 9p installsmoke "$SHARE" 2>/dev/null || say "share=none (results on the console only)"
LOG="$SHARE/install.log"

finish() {
	say "done"
	sync
	systemctl poweroff --no-block
	exit 0
}

disk=$(lsblk -dn -o NAME,TYPE | awk '$2 == "disk" && $1 !~ /^(sr|loop|zram|ram|md|nbd)/ {print $1; exit}')
say "target=${disk:-none}"
[ -n "$disk" ] || { say "result=FAIL no target disk"; finish; }

answers=/run/b1nix-install-smoke.conf
cat >"$answers" <<EOF
DISK=/dev/$disk
FS=btrfs
HOSTNAME=b1nix-installed
USERNAME=tester
FULLNAME=b1nix tester
PASSWORD=b1nix
TIMEZONE=UTC
EOF
say "install=started"
# Each "step ... done in Ns" line goes to the console too: the lane reports
# where the time went.
/usr/sbin/b1nix-install --config "$answers" 2>&1 | tee "$LOG" |
	grep --line-buffered 'b1nix-install: step .* done in\|installed b1nix' >/dev/console
if grep -q '^b1nix-install: installed b1nix' "$LOG"; then
	say "result=ok"
else
	say "result=FAIL $(grep -v '^b1nix-install: step' "$LOG" | tail -2 | tr '\n' ' ' | cut -c1-200)"
fi
finish
