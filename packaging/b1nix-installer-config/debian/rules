#!/usr/bin/make -f
# Configuration and scripts only; nothing is compiled.

PKG := debian/b1nix-installer-config

%:
	dh $@

override_dh_auto_install:
	# ── the live medium ────────────────────────────────────────────────
	install -D -m 0644 files/live/b1nix-live \
		$(PKG)/usr/share/initramfs-tools/scripts/b1nix-live
	install -D -m 0755 files/live/b1nix-live-hook \
		$(PKG)/usr/share/initramfs-tools/hooks/b1nix-live
	install -D -m 0644 files/live/getty-autologin.conf \
		$(PKG)/usr/lib/systemd/system/getty@tty1.service.d/b1nix-live.conf
	install -D -m 0644 files/live/getty-autologin.conf \
		$(PKG)/usr/lib/systemd/system/serial-getty@ttyS0.service.d/b1nix-live.conf
	install -D -m 0755 files/live/b1nix-install $(PKG)/usr/bin/b1nix-install
	install -D -m 0644 files/live/b1nix-live-motd $(PKG)/etc/motd.d/b1nix-live
	install -D -m 0755 files/live/b1nix-live-smoke \
		$(PKG)/usr/lib/b1nix/installer/b1nix-live-smoke
	# ── the installer ──────────────────────────────────────────────────
	install -D -m 0644 files/calamares/settings.conf $(PKG)/etc/calamares/settings.conf
	for f in files/calamares/modules/*.conf; do \
		install -D -m 0644 $$f $(PKG)/etc/calamares/modules/$$(basename $$f); \
	done
	for f in files/calamares/branding/b1nix/*; do \
		install -D -m 0644 $$f $(PKG)/etc/calamares/branding/b1nix/$$(basename $$f); \
	done
	install -D -m 0755 files/installer/b1nix-install-target \
		$(PKG)/usr/lib/b1nix/installer/b1nix-install-target
	install -D -m 0755 files/installer/b1nix-install-smoke \
		$(PKG)/usr/lib/b1nix/installer/b1nix-install-smoke

override_dh_installsystemd:
	dh_installsystemd --name=b1nix-live-smoke --no-start
	dh_installsystemd --name=b1nix-install-smoke --no-start
