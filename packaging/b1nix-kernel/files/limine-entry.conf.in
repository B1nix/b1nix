# One boot entry, expanded by b1nix-update-bootloader for every installed
# b1nix kernel. @RELEASE@ is the kernel release, @CMDLINE@ the command line
# from /etc/default/b1nix-boot plus the root device, and @SUFFIX@ is empty for
# the normal entry or a short note for the fallback and rescue ones.
#
# b1nix.entry= is not decoration: the initramfs hook reads it to know which
# entry actually booted, which is the only way to tell a hand-picked menu
# choice from the default one.

/b1nix @RELEASE@@SUFFIX@
    protocol: multiboot2
    path: boot():/b1nix-@RELEASE@
    cmdline: @CMDLINE@ b1nix.entry=@RELEASE@
    module_path: boot():/initrd-@RELEASE@
    module_string: initrd
