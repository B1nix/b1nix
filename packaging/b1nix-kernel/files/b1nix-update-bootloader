#!/bin/sh
# Regenerate /tools/image/limine.conf and the boot-counting state from the kernels
# that are actually installed. Called by b1nix-kernel's postinst and postrm,
# and safe to run by hand after editing /etc/default/b1nix-boot.
#
# The design, and the reason each decision is what it is, is in
# docs/distro/boot-counting.md. The short version: Limine cannot write to disk,
# so the operating system owns the state, and every path here has to fail
# towards a machine that still boots.
set -eu

ESP="${ESP:-/boot}"
STATE_DIR="$ESP/b1nix"
STATE="$STATE_DIR/boot-state"
CONF="$ESP/limine.conf"
ENTRY_TEMPLATE="${ENTRY_TEMPLATE:-/usr/share/b1nix/limine-entry.conf.in}"
DEFAULTS="${DEFAULTS:-/etc/default/b1nix-boot}"

TRIES="${TRIES:-3}"
TIMEOUT="${TIMEOUT:-3}"
CMDLINE_EXTRA=""
[ ! -r "$DEFAULTS" ] || . "$DEFAULTS"

log() { printf 'b1nix-update-bootloader: %s\n' "$*" >&2; }

[ -d "$ESP" ] || { log "no $ESP -- nothing to do"; exit 0; }
mkdir -p "$STATE_DIR"

# ── which kernels are installed ─────────────────────────────────────────────
# The release is whatever follows "b1nix-" in the file name. Sorted newest
# first by version, so "0.124.0" beats "0.99.0" and "0.124.10" beats
# "0.124.9" -- plain sort would get both wrong.
releases=$(
	for k in "$ESP"/b1nix-*; do
		[ -f "$k" ] || continue
		case "$k" in *.debug) continue ;; esac
		printf '%s\n' "${k##*/b1nix-}"
	done | sort -V -r
)
[ -n "$releases" ] || { log "no kernels in $ESP -- leaving $CONF alone"; exit 0; }

# ── the state file ──────────────────────────────────────────────────────────
# Read what we knew, drop entries whose kernel is gone, add entries for
# kernels we have not seen before. A missing or corrupt state file is not an
# error: it is rebuilt from what is on the ESP.
state_get() { # release field -> value, empty if unknown
	[ -f "$STATE" ] || return 0
	awk -v r="$1" -v f="$2" '
		$1 == "entry=" r {
			for (i = 2; i <= NF; i++) {
				split($i, kv, "=")
				if (kv[1] == f) { print kv[2]; exit }
			}
		}
	' "$STATE"
}

previous_default=""
[ ! -f "$STATE" ] || previous_default=$(sed -n 's/^default=//p' "$STATE" | head -1)

tmp="$STATE.new"
: >"$tmp"

# The default is the newest entry that has completed a boot, or -- when nothing
# has yet -- the newest kernel installed. A fresh install has no good entry and
# must still boot something.
default=""
for r in $releases; do
	[ "$(state_get "$r" good)" = "1" ] || continue
	default="$r"
	break
done
newest=$(printf '%s\n' "$releases" | head -1)
# A newly installed kernel becomes the default even though it is not good yet:
# that is the point of counting tries. It is only kept as the default while it
# has tries left.
newest_tries=$(state_get "$newest" tries)
newest_good=$(state_get "$newest" good)
if [ -z "$newest_good" ] || [ "$newest_good" = "1" ] || [ "${newest_tries:-$TRIES}" -gt 0 ]; then
	default="$newest"
fi
[ -n "$default" ] || default="$newest"

printf 'default=%s\n' "$default" >>"$tmp"
for r in $releases; do
	t=$(state_get "$r" tries)
	g=$(state_get "$r" good)
	[ -n "$t" ] || t="$TRIES"
	[ -n "$g" ] || g=0
	printf 'entry=%s tries=%s good=%s\n' "$r" "$t" "$g" >>"$tmp"
done
mv "$tmp" "$STATE"

[ "$previous_default" = "$default" ] || [ -z "$previous_default" ] ||
	log "default kernel is now $default (was $previous_default)"

# ── the bootloader configuration ────────────────────────────────────────────
root_spec="${ROOT_SPEC:-}"
if [ -z "$root_spec" ]; then
	# findmnt is in util-linux, which is Essential; the fallback keeps this
	# working in a chroot where /proc is not mounted.
	root_spec=$(findmnt -no SOURCE / 2>/dev/null || true)
	[ -n "$root_spec" ] || root_spec=$(awk '$2 == "/" { print $1; exit }' /proc/mounts 2>/dev/null || true)
fi
[ -n "$root_spec" ] || log "could not determine the root device; entries will carry no root="

conf_tmp="$CONF.new"
{
	printf '# Generated by b1nix-update-bootloader. Edits are lost on the next\n'
	printf '# kernel install; put your changes in %s instead.\n\n' "$DEFAULTS"
	printf 'timeout: %s\n' "$TIMEOUT"
	printf 'default_entry: 1\n'
	printf 'serial: yes\n\n'
} >"$conf_tmp"

emit_entry() { # release suffix extra-cmdline
	_r="$1"
	_suffix="$2"
	_extra="${3:-}"
	_cmdline=""
	[ -z "$root_spec" ] || _cmdline="root=$root_spec"
	[ -z "$CMDLINE_EXTRA" ] || _cmdline="$_cmdline $CMDLINE_EXTRA"
	[ -z "$_extra" ] || _cmdline="$_cmdline $_extra"
	sed -e "s|@RELEASE@|$_r|g" -e "s|@SUFFIX@|$_suffix|g" -e "s|@CMDLINE@|$_cmdline|g" \
		"$ENTRY_TEMPLATE" | sed '/^#/d'
	printf '\n'
}

# The default first, because Limine boots default_entry: 1; then the rest,
# newest first; then a single-user entry as the floor. The rescue entry is
# never counted and never becomes the default -- it carries b1nix.single, and
# the hook ignores any entry it did not write state for.
emit_entry "$default" "" >>"$conf_tmp"
for r in $releases; do
	[ "$r" != "$default" ] || continue
	emit_entry "$r" " (previous)" >>"$conf_tmp"
done
emit_entry "$default" " (rescue: single user)" "b1nix.single b1nix.no-boot-count" >>"$conf_tmp"

mv "$conf_tmp" "$CONF"
sync 2>/dev/null || true
log "wrote $CONF ($(printf '%s\n' "$releases" | wc -l | tr -d ' ') kernel(s), default $default)"
