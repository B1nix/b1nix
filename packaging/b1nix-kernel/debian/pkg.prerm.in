#!/bin/sh
# b1nix-kernel-@RELEASE@ prerm: refuse to remove the kernel the machine is
# running, and refuse to remove the last one known to boot.
#
# A package that can leave a machine unbootable through a routine
# `apt autoremove` is a defect. This is the check that prevents it; the
# override for someone who really means it is B1NIX_ALLOW_KERNEL_REMOVAL=1.
set -e

RELEASE="@RELEASE@"
ESP="${ESP:-/boot}"
STATE="$ESP/b1nix/boot-state"

refuse() {
	echo "b1nix-kernel: refusing to remove $RELEASE: $1" >&2
	echo "b1nix-kernel: set B1NIX_ALLOW_KERNEL_REMOVAL=1 if you are sure." >&2
	exit 1
}

case "$1" in
remove | deconfigure)
	[ "${B1NIX_ALLOW_KERNEL_REMOVAL:-0}" = "1" ] && exit 0

	running=$(uname -r 2>/dev/null || true)
	[ "$running" != "$RELEASE" ] || refuse "it is the running kernel"

	if [ -f "$STATE" ]; then
		# How many entries other than this one have completed a boot? If
		# none has, this kernel is the only thing known to work.
		others=$(awk -v r="$RELEASE" '
			/^entry=/ {
				e = substr($1, 7)
				if (e == r) next
				for (i = 2; i <= NF; i++) {
					split($i, kv, "=")
					if (kv[1] == "good" && kv[2] == "1") { n++ }
				}
			}
			END { print n + 0 }
		' "$STATE")
		[ "$others" -gt 0 ] || refuse "it is the last kernel known to boot"
	fi
	;;
upgrade | failed-upgrade) ;;
esac

#DEBHELPER#

exit 0
