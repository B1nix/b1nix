  kernel/lib/ftrace.c \
  kernel/lib/ftrace_demo.c

# Objects mirror the source tree under ${OBJDIR} (parallel directories). :R
# strips the .c/.S suffix; the :@s@...@ loop modifier rewrites each entry.
OBJS = ${SRCS:R:@s@${OBJDIR}/${s}.o@}

.PHONY: all clean
all: ${KERNEL}

# One explicit rule per translation unit. BSD make has suffix rules but no
# GNU-style %-patterns that can map a source tree onto a parallel object tree,
# so .for generates the rules instead. The gcc driver assembles .S like it
# compiles .c, so both suffixes take the same recipe.
.for s in ${SRCS}
${OBJDIR}/${s:R}.o: ${SRC}/${s}
	@mkdir -p ${.TARGET:H}
	@echo "KBUILD cc ${s:R}"
	${CC} ${CFLAGS} -c ${.ALLSRC} -o ${.TARGET}
.endfor

# Link via a response file, NOT $(OBJS) on the command line. b1nix's exec()
# truncates an over-long argv, so passing all 85 object paths (~3.5 KB) directly
# silently drops most of them and the link fails with dozens of bogus "undefined
# reference"s. ld reads @RSP from the file instead (no argv limit) — the same
# trick the flat build-kernel.sh uses. RSP is a static, host-generated list
# (kernel-make.rsp) staged alongside this Makefile; regenerate it whenever SRCS
# changes (it must match $(OBJS) for OBJDIR=/tmp/kbuild).
RSP ?= ${SRC}/tools/inguest/kernel-make.rsp

${KERNEL}: ${OBJS}
	@echo KBUILD-LINK
	${LD} ${LDFLAGS} -o ${.TARGET} @${RSP}
	@echo KBUILD-LINK-DONE
	@echo KBUILD-DONE

clean:
	rm -rf ${OBJDIR} ${KERNEL}
