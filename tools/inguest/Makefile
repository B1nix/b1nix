# In-guest kernel build, driven by the in-guest make running INSIDE b1nix.
#
# Closes roadmap 416: a real Makefile (variables, generated rules, automatic
# variables, prerequisite/mtime tracking) replaces the old hand-unrolled build.
#
# Written in POSIX/BSD make syntax for bmake, which is /bin/make on b1nix since
# M98 retired the GNU Make port. That means .for/.if directives and ${VAR:mod}
# modifiers rather than GNU's $(patsubst)/ifeq/%-pattern rules — the rules for
# each translation unit are generated by a .for loop below instead.
#
# Invoke in-guest (rootfs mounted at /persist, source staged at
# /persist/usr/src/b1nix, native toolchain at /persist/bin):
#
#   make -f /persist/usr/src/b1nix/tools/inguest/Makefile
#
# Output: ${KERNEL} (= /tmp/kernel.elf). Emits KBUILD-START / KBUILD-LINK /
# KBUILD-DONE markers compatible with tools/inguest/run-build.py.
#
# Paths are overridable so the same Makefile works under other layouts:
#   make -f Makefile SRC=. OBJDIR=./obj CC=gcc LD=ld KERNEL=./kernel.elf

SRC     ?= /persist/usr/src/b1nix
OBJDIR  ?= /tmp/kbuild
KERNEL  ?= /tmp/kernel.elf

# bmake's sys.mk predefines CC=cc and LD=ld, and `?=` does not override an
# already-defined variable — so a bare `make -f Makefile` would invoke `cc`/`ld`
# (Error 127 in-guest: there is no /bin/cc). Force the b1nix native toolchain
# unless the caller set something else on the command line / in the environment.
.if !defined(CC) || ${CC} == "cc"
CC = /persist/bin/gcc
.endif
.if !defined(LD) || ${LD} == "ld"
LD = /persist/bin/ld
.endif

CFLAGS  = -std=c11 -ffreestanding -fno-builtin -fno-stack-protector -fno-pic \
          -mno-red-zone -I${SRC}/kernel/include -mcmodel=kernel \
          -mno-sse -mno-mmx -mno-sse2 -mno-3dnow
LDFLAGS = -m elf_x86_64 -z max-page-size=0x1000 \
          -T ${SRC}/kernel/arch/x86_64/linker.ld

# Kernel translation units (relative to $(SRC)); .S files are assembled by the
# gcc driver just like .c. Mirrors the x86_64 KERNEL_SOURCES of the host Makefile.
SRCS = \
  kernel/arch/x86_64/arch.c \
  kernel/arch/x86_64/boot.S \
  kernel/arch/x86_64/console.c \
  kernel/arch/x86_64/context_switch.S \
  kernel/arch/x86_64/fb_console.c \
  kernel/arch/x86_64/fpu.S \
  kernel/arch/x86_64/interrupts.c \
  kernel/arch/x86_64/io.c \
  kernel/arch/x86_64/isr.S \
  kernel/arch/x86_64/lapic.c \
  kernel/arch/x86_64/paging.c \
  kernel/arch/x86_64/rtc.c \
  kernel/arch/x86_64/serial.c \
  kernel/arch/x86_64/signal.c \
  kernel/arch/x86_64/syscall_entry.S \
  kernel/arch/x86_64/user_jump.S \
  kernel/bootinfo/multiboot2.c \
  kernel/dev/ahci.c \
  kernel/dev/blk.c \
  kernel/dev/compositor.c \
  kernel/dev/nvme.c \
  kernel/dev/pci.c \
  kernel/dev/ps2_kbd.c \
  kernel/dev/ps2_mouse.c \
  kernel/dev/video.c \
  kernel/dev/virtio_blk.c \
  kernel/dev/virtio_gpu.c \
  kernel/dev/virtio.c \
  kernel/fs/aio.c \
  kernel/fs/btrfs.c \
  kernel/fs/ext1.c \
  kernel/fs/ext2.c \
  kernel/fs/ext3.c \
  kernel/fs/ext4.c \
  kernel/fs/fat32.c \
  kernel/fs/filelock.c \
  kernel/fs/initramfs.c \
  kernel/fs/journal.c \
  kernel/fs/pipe.c \
  kernel/fs/vfs.c \
  kernel/fs/vfs_slab.c \
  kernel/ipc/mqueue.c \
  kernel/ipc/shm.c \
  kernel/lib/klog.c \
  kernel/lib/stdio.c \
  kernel/lib/stdlib.c \
  kernel/lib/string.c \
  kernel/lib/unistd.c \
  kernel/main.c \
  kernel/mm/eviction.c \
  kernel/mm/kheap.c \
  kernel/mm/page_cache.c \
  kernel/mm/pmm.c \
  kernel/mm/swap.c \
  kernel/net/arp.c \
  kernel/net/dhcp.c \
  kernel/net/dns.c \
  kernel/net/ethernet.c \
  kernel/net/icmp.c \
  kernel/net/ipv4.c \
