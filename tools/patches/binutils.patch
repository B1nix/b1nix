diff -urN binutils-2.41/bfd/config.bfd binutils-2.41-patched/bfd/config.bfd
--- binutils-2.41/bfd/config.bfd
+++ binutils-2.41-patched/bfd/config.bfd
@@ -680,6 +680,11 @@
     targ_selvecs="i386_elf32_vec iamcu_elf32_vec"
     want64=true
     ;;
+  x86_64-*-b1nix*)
+    targ_defvec=x86_64_elf64_vec
+    targ_selvecs="i386_elf32_vec iamcu_elf32_vec x86_64_elf32_vec"
+    want64=true
+    ;;
   x86_64-*-elf* | x86_64-*-rtems* | x86_64-*-fuchsia | x86_64-*-genode*)
     targ_defvec=x86_64_elf64_vec
     targ_selvecs="i386_elf32_vec iamcu_elf32_vec x86_64_elf32_vec"
diff -urN binutils-2.41/gas/configure.tgt binutils-2.41-patched/gas/configure.tgt
--- binutils-2.41/gas/configure.tgt
+++ binutils-2.41-patched/gas/configure.tgt
@@ -227,6 +227,7 @@
   i386-*-beos*)				fmt=elf ;;
   i386-*-elfiamcu)			fmt=elf arch=iamcu ;;
   i386-*-elf*)				fmt=elf ;;
+  i386-*-b1nix*)			fmt=elf ;;
   i386-*-fuchsia*)			fmt=elf ;;
   i386-*-haiku*)			fmt=elf em=haiku ;;
   i386-*-genode*)			fmt=elf ;;
diff -urN binutils-2.41/ld/configure.tgt binutils-2.41-patched/ld/configure.tgt
--- binutils-2.41/ld/configure.tgt
+++ binutils-2.41-patched/ld/configure.tgt
@@ -1023,6 +1023,10 @@
 			tdir_elf_i386=`echo ${targ_alias} | \
 			    sed -e 's/x86_64/i386/' -e 's/aout//'`
 			;;
+x86_64-*-b1nix*)
+			targ_emul=elf_x86_64
+			targ_extra_emuls="elf_i386"
+			;;
 x86_64-*-elf* | x86_64-*-rtems* | x86_64-*-fuchsia* | x86_64-*-genode*)
 			targ_emul=elf_x86_64
 			targ_extra_emuls="elf_i386 elf_iamcu elf32_x86_64"
