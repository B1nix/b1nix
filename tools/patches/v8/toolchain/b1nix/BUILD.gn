# Copyright 2026 b1nix. GN toolchain for the b1nix target_os.
# Drop this file at //build/toolchain/b1nix/BUILD.gn inside the V8 checkout.
# It is selected by the `target_os == "b1nix"` branch added to
# //build/config/BUILDCONFIG.gn (see ../../PORT-PLAN.md, patch 1).
#
# Models build/toolchain/linux/BUILD.gn:182 gcc_toolchain("x64"), but points
# every tool at the existing x86_64-b1nix cross GCC (GCC 13.2, C++17/20 +
# libstdc++ from M55).
#
# M64 Phase 2: optional Clang frontend for the b1nix TARGET only. When the gn
# arg b1nix_use_clang=true, the b1nix objects are compiled with a host clang
# (b1nix_clang_*) using the SAME GCC libstdc++ headers — flags computed and
# passed in by tools/v8-gen-clang.sh (mirrors tools/b1nix-c++). The final d8 is
# relinked by tools/v8-link-d8.sh against the GNU runtime regardless of
# frontend, so only the .o compile path differs between the GCC and Clang
# builds. GCC stays the default (b1nix_use_clang defaults false).
#
# NB: this is a SEPARATE arg from the global is_clang ON PURPOSE. The host /
# snapshot toolchains (torque, mksnapshot) must stay on the system GCC — a
# global is_clang=true flips them to a Chromium-clang config that wants a
# bundled compiler-rt (libclang_rt.builtins.a) the system clang doesn't ship.
# Only the b1nix toolchain's own toolchain_args.is_clang is flipped below.

import("//build/toolchain/gcc_toolchain.gni")

# Absolute prefix of the b1nix cross toolchain on the build host. Override with
#   gn gen ... --args='b1nix_toolprefix="/abs/path/x86_64-b1nix-"'
# Default assumes the in-tree cross build (CLAUDE.md "Tier 1: Cross Toolchain").
# Source root `//` is build/toolchain_build/v8-skeleton/v8; the cross toolchain
# lives at build/toolchain_build/x86_64-b1nix/cross — two levels up from `//`.
declare_args() {
  # `//` is build/x86_64/toolchain/v8-skeleton/v8; the flat cross toolchain
  # (env.sh's TOOLCHAIN_BUILD_HOME/cross, no per-triplet subdir) is two levels
  # up, in its sibling build/x86_64/toolchain/cross/bin/.
  b1nix_toolprefix = rebase_path(
          "//../../cross/bin/x86_64-b1nix-", root_build_dir)

  # Clang frontend (M64 Phase 2). Only consulted when b1nix_use_clang=true. The
  # cppflags carry --target + the -nostdinc/-isystem GCC-header search path that
  # tools/b1nix-c++ uses; passed in by tools/v8-gen-clang.sh.
  b1nix_use_clang = false
  b1nix_clang_cc = "clang"
  b1nix_clang_cxx = "clang++"
  b1nix_clang_cppflags = ""
}

gcc_toolchain("x64") {
  # b1nix is GCC-free (M90): the cross toolchain is a clang wrapper (x86_64-b1nix-cc/-c++),
  # there is no x86_64-b1nix-gcc/-g++. Always use it — b1nix_use_clang / the
  # b1nix_clang_* args only matter if a caller wants a *different* clang
  # invocation (e.g. tools/v8-gen-clang.sh's flag set) than the standard wrapper.
  if (b1nix_use_clang) {
    cc = b1nix_clang_cc
    cxx = b1nix_clang_cxx
    extra_cppflags = b1nix_clang_cppflags
  } else {
    cc = "${b1nix_toolprefix}cc"
    cxx = "${b1nix_toolprefix}c++"
  }

  readelf = "${b1nix_toolprefix}readelf"
  nm = "${b1nix_toolprefix}nm"
  ar = "${b1nix_toolprefix}ar"
  ld = cxx

  enable_linker_map = true

  toolchain_args = {
    current_cpu = "x64"
    current_os = "b1nix"

    use_remoteexec = false
    is_clang = b1nix_use_clang
  }
}
