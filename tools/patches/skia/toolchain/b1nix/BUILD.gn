# Copyright 2026 b1nix. GN toolchain for the b1nix target_os.
# Drop this file at //build/toolchain/b1nix/BUILD.gn inside the Skia checkout.
# Selected by the `target_os == "b1nix"` branch in
# //build/config/BUILDCONFIG.gn (see apply.sh, Patch S1).
#
# Adapted from the V8 b1nix toolchain (tools/patches/v8/toolchain/b1nix/BUILD.gn).
# Default to Clang (b1nix is Clang-first since M89/M90).
#
# Builds against the b1nix cross sysroot with shared libc++ (M89).

import("//build/toolchain/gcc_toolchain.gni")

declare_args() {
  b1nix_toolprefix = rebase_path(
          "//../../x86_64-b1nix/cross/bin/x86_64-b1nix-", root_build_dir)

  b1nix_clang_cc = "clang"
  b1nix_clang_cxx = "clang++"
  b1nix_clang_cppflags = ""
}

gcc_toolchain("x64") {
  cc = b1nix_clang_cc
  cxx = b1nix_clang_cxx
  extra_cppflags = b1nix_clang_cppflags

  readelf = "${b1nix_toolprefix}readelf"
  nm = "${b1nix_toolprefix}nm"
  ar = "${b1nix_toolprefix}ar"
  ld = cxx

  enable_linker_map = true

  toolchain_args = {
    current_cpu = "x64"
    current_os = "b1nix"

    use_remoteexec = false
    is_clang = true
  }
}
