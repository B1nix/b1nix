CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_FEATURE_VERSION=y
CONFIG_SH_IS_ASH=y
# CONFIG_SH_IS_HUSH is not set
# CONFIG_SH_IS_NONE is not set
# CONFIG_BASH_IS_ASH is not set
# CONFIG_BASH_IS_HUSH is not set
CONFIG_BASH_IS_NONE=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_YES=y
CONFIG_ECHO=y
CONFIG_PRINTF=y
CONFIG_PWD=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_CAT=y
CONFIG_CMP=y
CONFIG_CUT=y
CONFIG_ENV=y
CONFIG_HEAD=y
CONFIG_ID=y
CONFIG_LS=y
CONFIG_TREE=y
CONFIG_PRINTENV=y
CONFIG_TAIL=y
CONFIG_TEE=y
CONFIG_TR=y
CONFIG_WC=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_LN=y
CONFIG_READLINK=y
CONFIG_TOUCH=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_SYNC=y
CONFIG_SLEEP=y
CONFIG_DATE=y
CONFIG_UNAME=y
CONFIG_KILL=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_SORT=y
CONFIG_TSORT=y
CONFIG_UNIQ=y
CONFIG_WHOAMI=y
CONFIG_SEQ=y
CONFIG_WHICH=y
CONFIG_CLEAR=y
CONFIG_HEXDUMP=y
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_REALPATH=y
CONFIG_GETFATTR=y
# (b1nix gained SYS_GETXATTR/LISTXATTR + a per-inode xattr backend in M44)
CONFIG_MKTEMP=y
CONFIG_FIND=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_XARGS=y
CONFIG_DIFF=y
CONFIG_CKSUM=y
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y
CONFIG_SHA384SUM=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_FEATURE_SORT_BIG=y
# Migration wave 2b: file/archive utilities.
CONFIG_DD=y
CONFIG_FEATURE_DD_IBS_OBS=y
CONFIG_FEATURE_DD_STATUS=y
CONFIG_FEATURE_DD_THIRD_STATUS_LINE=y
CONFIG_DU=y
CONFIG_FEATURE_DU_DEFAULT_BLOCKSIZE_1K=y
CONFIG_DF=y
CONFIG_FEATURE_DF_FANCY=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_AUTODETECT=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_TAR_LONG_OPTIONS=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_BZ2=y
CONFIG_FEATURE_SEAMLESS_XZ=y
CONFIG_GZIP=y
CONFIG_FEATURE_GZIP_LONG_OPTIONS=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_BZIP2=y
CONFIG_BUNZIP2=y
CONFIG_BZCAT=y
CONFIG_UNXZ=y
CONFIG_XZCAT=y
# Migration wave 3: process & system inspection (procps + util-linux).
CONFIG_PS=y
CONFIG_TOP=y
CONFIG_FEATURE_TOP_INTERACTIVE=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_FEATURE_TOP_DECIMALS=y
CONFIG_UPTIME=y
CONFIG_PIDOF=y
CONFIG_FEATURE_PIDOF_SINGLE=y
CONFIG_FEATURE_PIDOF_OMIT=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_FREE=y
CONFIG_VMSTAT=y
CONFIG_DMESG=y
CONFIG_FEATURE_DMESG_PRETTY=y
# Migration wave 4: storage & networking inspection/config.
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FAKE=y
CONFIG_FEATURE_MOUNT_VERBOSE=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_NSLOOKUP=y
CONFIG_LSOF=y
CONFIG_NETSTAT=y
CONFIG_FEATURE_NETSTAT_WIDE=y
CONFIG_ROUTE=y
CONFIG_IFCONFIG=y
CONFIG_FEATURE_IFCONFIG_STATUS=y
CONFIG_FEATURE_IFCONFIG_HW=y
CONFIG_BLKID=y
CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_VOLUMEID=y
CONFIG_FEATURE_VOLUMEID_EXT=y
CONFIG_FEATURE_VOLUMEID_FAT=y
CONFIG_FDISK=y
CONFIG_FEATURE_FDISK_BLKSIZE=y
CONFIG_FEATURE_FDISK_WRITABLE=y
CONFIG_UUIDGEN=y
# Migration wave 4b: ping (raw ICMP sockets), losetup (loop devices),
# ip (rtnetlink).
CONFIG_PING=y
CONFIG_FEATURE_FANCY_PING=y
CONFIG_LOSETUP=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
# Migration wave 5: upstream ash as /opt/busybox/bin/ash and /bin/sh
# when B1NIX_UPSTREAM_BUSYBOX embeds this BusyBox binary.
CONFIG_SHELL_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
# CONFIG_ASH_BASH_COMPAT is not set
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
# CONFIG_ASH_RANDOM_SUPPORT is not set
CONFIG_ASH_EXPAND_PRMT=y
# CONFIG_ASH_IDLE_TIMEOUT is not set
# CONFIG_ASH_MAIL is not set
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
# ASH_SLEEP removed in BusyBox 1.38
CONFIG_ASH_HELP=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_SH_MATH_BASE=y
CONFIG_FEATURE_SH_EXTRA_QUIET=y
# CONFIG_FEATURE_SH_STANDALONE is not set
# CONFIG_FEATURE_SH_NOFORK is not set
# CONFIG_FEATURE_SH_READ_FRAC is not set
# CONFIG_FEATURE_SH_HISTFILESIZE is not set
# CONFIG_FEATURE_SH_EMBEDDED_SCRIPTS is not set
# Migration wave 6: account management — login/su/passwd suite, gated behind
# the security-sensitive UPSTREAM_BUSYBOX test scenario. BusyBox uses its own
# internal pwd/grp/shadow parsers and crypt (SHA-256/512) so the applets are
# fully self-contained: they read /etc/passwd, /etc/shadow, /etc/group directly
# and hash new passwords with standard sha512-crypt ($6$). B1NIX keeps PID 1
# (no BusyBox init); these are user-invoked account tools, not the system init.
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha512"
CONFIG_LOGIN=y
# CONFIG_LOGIN_SESSION_AS_CHILD is not set
# CONFIG_LOGIN_SCRIPTS is not set
# CONFIG_FEATURE_NOLOGIN is not set
# CONFIG_FEATURE_SECURETTY is not set
CONFIG_SU=y
# CONFIG_FEATURE_SU_SYSLOG is not set
# CONFIG_FEATURE_SU_CHECKS_SHELLS is not set
# CONFIG_FEATURE_SU_BLANK_PW_NEEDS_SECURE_TTY is not set
CONFIG_PASSWD=y
# CONFIG_FEATURE_PASSWD_WEAK_CHECK is not set
CONFIG_CHPASSWD=y
CONFIG_CRYPTPW=y
# CONFIG_MKPASSWD is not set
CONFIG_ADDUSER=y
# CONFIG_FEATURE_ADDUSER_TO_GROUP is not set
# CONFIG_FEATURE_CHECK_NAMES is not set
CONFIG_FIRST_SYSTEM_ID=100
CONFIG_LAST_SYSTEM_ID=999
CONFIG_LAST_ID=60000
CONFIG_ADDGROUP=y
# FEATURE_ADDGROUP_LONG_OPTIONS removed in BusyBox 1.38
CONFIG_DELUSER=y
CONFIG_DELGROUP=y
# CONFIG_FEATURE_DEL_USER_FROM_GROUP is not set
CONFIG_GETTY=y
# CONFIG_SULOGIN is not set
# CONFIG_VLOCK is not set
# CONFIG_ADD_SHELL is not set
# CONFIG_REMOVE_SHELL is not set
