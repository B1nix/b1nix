#!/bin/sh
grep -q 'b1nix.test=1' /proc/cmdline 2>/dev/null || exit 0
trap '' USR2 HUP TERM INT ALRM

# NOTE: this script prints no boot marker of its own. It used to echo
# "init: ... pid=1" and two "M94-INIT: ok ..." lines, which were forgeries — a
# shell in the default runlevel cannot know what PID 1 is or how the kernel
# parsed `init=`. Those lines come from the kernel itself (kernel/main.c), which
# is the only thing that can report them truthfully.

[ -x /etc/rc ] && /bin/sh /etc/rc

SMOKE_SYS=0
SMOKE_BLK=0
SMOKE_GFX=0
SMOKE_POSIX=0
if grep -q 'b1nix.smoke=sys' /proc/cmdline 2>/dev/null; then
    SMOKE_SYS=1
elif grep -q 'b1nix.smoke=gfx' /proc/cmdline 2>/dev/null; then
    SMOKE_GFX=1
elif grep -q 'b1nix.smoke=posix' /proc/cmdline 2>/dev/null; then
    SMOKE_POSIX=1
elif grep -q 'b1nix.smoke=blk' /proc/cmdline 2>/dev/null; then
    SMOKE_BLK=1
elif grep -q 'b1nix.smoke=init' /proc/cmdline 2>/dev/null; then
    # M108: the init instance. PID 1 drives the checks itself from /etc/inittab
    # (see /etc/init-smoke.sh). Nothing of the ordinary suite runs here — but
    # leaving a breadcrumb proves something the test cannot otherwise see from
    # the outside: that OpenRC's `default` runlevel really executed, with its
    # local.d hooks, under BusyBox init. m108_smoke checks for this file; it is
    # never written on any other instance.
    : > /tmp/m108-openrc-local-ran
    exit 0
elif grep -q 'b1nix.openrc-ctltest' /proc/cmdline 2>/dev/null; then
    # The openrc instance: openrc-init is PID 1 and the control-FIFO test runs
    # for real from /etc/local.d/zz-ctltest.start -> /etc/openrc-ctltest.sh,
    # which waits for /run/openrc/init.ctl and asks PID 1 to power the machine
    # off through it. Nothing to do here.
    #
    # This branch used to echo "M94-OPENRC: ok init-fifo-present",
    # "/etc/init.d/killprocs start" and "reboot: powering off" and then call
    # `poweroff -f` — it forged every marker of the test AND powered the machine
    # off before the real path could run, so the check could not fail. The
    # markers now come from the FIFO waiter, from OpenRC's shutdown runlevel and
    # from the kernel's own poweroff path respectively.
    #
    # What does belong here: the PID 1 questions only a process running under
    # this init can answer — is PID 1 really the openrc-init ELF, does it reap
    # an orphan, does the system it brought up run a shell. They are the same
    # checks the BusyBox-init instance makes, so both inits carry the same
    # evidence. This runs to completion before zz-ctltest.start's waiter can
    # power the machine off (local.d hooks run in name order, and the FIFO only
    # appears once every runlevel is done).
    [ -x /bin/m108_smoke ] && /bin/m108_smoke openrccheck
    exit 0
else
    SMOKE_SYS=1
    SMOKE_GFX=1
    SMOKE_POSIX=1
    SMOKE_BLK=1
fi

run_test() {
    bin="$1"
    inst="$2"
    if [ ! -x "$bin" ]; then return; fi
    case "$inst" in
        sys) [ "$SMOKE_SYS" = "1" ] && "$bin" ;;
        blk) [ "$SMOKE_BLK" = "1" ] && "$bin" ;;
        posix) [ "$SMOKE_POSIX" = "1" ] && "$bin" ;;
        gfx) [ "$SMOKE_GFX" = "1" ] && "$bin" ;;
    esac
}

# m47_smoke owns /dev/fb0 for its fb-persist check: it writes pixels, unmaps,
# remaps and expects them back, so nothing else may draw to the framebuffer
# while it runs.
if [ "$SMOKE_GFX" = "1" ]; then
    run_test /bin/m47_smoke gfx
fi

# ---- sys (kernel, ipc, elf, selftest, diag, misc) ----
run_test /bin/native_smoke sys
run_test /bin/m12_smoke sys
run_test /bin/m13_smoke sys
run_test /bin/m15_smoke sys
run_test /bin/m17_smoke sys
run_test /bin/m56_smoke sys
run_test /bin/m57_smoke sys
run_test /bin/m75_smoke sys
run_test /bin/m8_aio_test sys
run_test /bin/test_sync sys
run_test /bin/m25_smoke sys
run_test /bin/m26_smoke sys
run_test /bin/m27_smoke sys
run_test /bin/m32_smoke sys
run_test /bin/m32_nettool sys
run_test /bin/m32_pcre2_smoke sys
run_test /bin/m53_zlib_smoke sys
run_test /bin/m53_libpng_smoke sys
run_test /bin/m53_libjpeg_smoke sys
run_test /bin/m53_libwebp_smoke sys
run_test /bin/m53_libvpx_smoke sys
run_test /bin/m53_wapcaplet_smoke sys
run_test /bin/m53_parserutils_smoke sys
run_test /bin/m53_hubbub_smoke sys
run_test /bin/m53_libcss_smoke sys
run_test /bin/m53_libdom_smoke sys
run_test /bin/m53_nslibs_smoke sys
run_test /bin/m34_smoke sys
run_test /bin/m35_smoke sys
run_test /bin/m77_smoke sys
run_test /bin/m36_smoke sys
run_test /bin/m30_pie sys
run_test /bin/cxx_smoke sys
run_test /bin/m55_iostream sys
run_test /bin/m64_clang_smoke sys
run_test /bin/m98_smoke sys
run_test /bin/m104_pam_smoke sys
run_test /bin/net_smoke sys
run_test /bin/m_posixmm_smoke sys
run_test /bin/shmshare_smoke sys
run_test /bin/musl_posix_smoke sys
run_test /bin/b1cc_selfsmoke sys
run_test /bin/m30_dynamic sys
run_test /bin/m24_stress sys
run_test /bin/m39_smoke sys

# ---- blk (storage) ----
run_test /bin/m14_smoke blk
# M109 needs the virtio-blk scratch disk and the nvme ext4 image, and it mounts
# the latter at /mnt/ext4nvme — so it runs after m14_smoke has released it.
run_test /bin/m109_smoke blk
run_test /bin/m24b_smoke sys
# Flash, as flash rather than as a slow disk. Only this instance is given a
# chip (see tests/smoke.sh, which passes the pflash pair).
if [ "$SMOKE_BLK" = "1" ] && [ -e /dev/mtd0 ]; then
    /bin/sh /etc/mtd-smoke.sh
fi

run_test /bin/diskbench blk
run_test /bin/ext_stress blk

# ---- gfx (graphics) ----
run_test /bin/m53_virgl_smoke gfx
run_test /bin/m38_sound gfx
run_test /bin/m79_sound gfx
run_test /bin/m48_smoke gfx
run_test /bin/m49_libwayland gfx
run_test /bin/m49_libwayland_server gfx
run_test /bin/m50_smoke gfx
run_test /bin/m101t_smoke gfx
run_test /bin/m100_smoke gfx
run_test /bin/m51_smoke gfx
run_test /bin/m51_pixman_smoke gfx
run_test /bin/m51_freetype_smoke gfx
run_test /bin/m51_cairo_smoke gfx
run_test /bin/m51_xkb_smoke gfx
run_test /bin/m51_harfbuzz_smoke gfx
run_test /bin/m51_fontconfig_smoke gfx
run_test /bin/m51_clipboard_smoke gfx

# Composition, both paths. Software (pixman) and accelerated (GLES on a DRM
# render node) are separate supported configurations, so each is run on purpose
# and each carries its own marker — see /etc/render-smoke.sh. A shell script
# rather than an ELF because the subject is the compositor and its clients.
if [ "$SMOKE_GFX" = "1" ] && [ -x /etc/render-smoke.sh ]; then
    /bin/sh /etc/render-smoke.sh
fi

# ---- posix (shell, coreutils, job control) ----
run_test /bin/m13_job_control posix
run_test /bin/m29_smoke posix
run_test /bin/m31_smoke posix
run_test /bin/m73_smoke posix
run_test /bin/m80_smoke posix
run_test /bin/m108_smoke posix
run_test /bin/m86_smoke posix
run_test /bin/m95_smoke posix
run_test /bin/m96_smoke posix
run_test /bin/m107_smoke posix
# M109: the uevent hot-plug channel. Creates and destroys /dev/loop8 and runs
# mdev, so it must not overlap another test touching /dev — hence the same
# sequential group.
run_test /bin/m109_uevent_smoke posix
run_test /bin/m63_smoke posix
run_test /bin/m71_aslr posix
run_test /bin/m42_w5pre_smoke posix
run_test /bin/m46_smoke posix
run_test /bin/lock_smoke posix
run_test /bin/futex_stress posix
run_test /bin/invite_stress posix
run_test /bin/pipe_eof posix
run_test /bin/fd_visibility posix
run_test /bin/clock_sanity posix
run_test /bin/yield_fairness posix
run_test /bin/m27_cmdline posix
run_test /bin/m11_pipe_smoke posix
run_test /bin/m22_smoke posix
run_test /bin/m16_smoke posix
run_test /bin/m58_smoke posix
run_test /bin/m92_abi_smoke posix

if [ "$SMOKE_SYS" = "1" ]; then
    for s in /etc/posix-smoke.sh /etc/initctl-smoke.sh /etc/zsh-smoke.sh \
             /etc/bpkg-smoke.sh /etc/m40-smoke.sh /etc/m67-smoke.sh; do
        [ -x "$s" ] || continue
        case "$s" in
            /etc/zsh-smoke.sh) /bin/zsh "$s" ;;
            *) /bin/sh "$s" ;;
        esac
    done
fi

# Where the run's CPU time went, sampled by the timer tick on every core
# (kernel/lib/kprof.c). Reading /proc/b1nix-prof is what prints it -- the
# counters are kept all along and nothing else in the tree asks for them, so
# they were collected every run and read none. The user/kernel/idle
# distribution costs one increment per tick and is always on; the per-function
# histogram needs b1nix.sysprof on the kernel command line.
# Not guarded by [ -r ]: that test was false here (the node is a VFS_DEVICE)
# and the read silently did not happen, which looks exactly like a profile of
# zero. Let a missing file say so instead.
cat /proc/b1nix-prof || echo "SMOKE: /proc/b1nix-prof unreadable — no CPU profile"

echo "B1NIX-TEST: done"

# Powering off is how a QEMU instance ends: the host has the serial log already,
# so there is nothing left to read on the guest. A board whose only console is
# its own panel is the opposite case — switching it off is what destroys the
# results. `b1nix.keep-running` leaves the machine up with the last screenful of
# markers still on it.
grep -q 'b1nix.keep-running' /proc/cmdline 2>/dev/null && exit 0

( sleep 1; /bin/poweroff -f || /bin/halt -f || /sbin/openrc-shutdown --no-write --poweroff now ) &
