#!/usr/bin/env bash
# Compiler shim for the Mesa cross build.
# No --sysroot (breaks clang's stddef.h). Use -isystem for b1nix headers.
# libc++ headers MUST come before b1nix headers (for stddef.h wrapper).
set -eu
real="$1"; shift

for arg in "$@"; do
  case "$arg" in
    --version|-dumpversion|-dumpmachine)
      exec "$real" "$@" ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
. "$PROJECT_DIR/tools/toolchain/env.sh"
CROSS="$TOOLCHAIN_BUILD_HOME/cross"

USING_CXX=0
IS_LINK=1
for arg in "$@"; do
  case "$arg" in
    *.cc|*.cpp|*.cxx|*.C) USING_CXX=1 ;;
    -c|-E) IS_LINK=0 ;;
  esac
done

B1NIX_INC="$CROSS/$B1NIX_TRIPLET/include"
EXTRA_FLAGS=""
MUSL_INC="$PROJECT_DIR/build/musl-b1nix/$B1NIX_TRIPLET/install/usr/include"
CLANG_INC="$(clang -print-resource-dir 2>/dev/null)/include"

if [ "$USING_CXX" -eq 1 ]; then
  LIBCXX_HDR="$TOOLCHAIN_BUILD_HOME/llvm-runtimes-build/libcxx-install/include/c++/v1"
  # libc++ headers FIRST (for stddef.h wrapper), then musl libc headers when
  # present (b1nix headers only as a fallback: their errno.h declares
  # `extern int errno`, a data symbol musl's libc.so does not export --
  # objects built against them fail to relocate at runtime).
  if [ -d "$MUSL_INC" ]; then
    EXTRA_FLAGS="-nostdinc++ -isystem $LIBCXX_HDR -isystem $MUSL_INC -idirafter $B1NIX_INC"
  else
    EXTRA_FLAGS="-nostdinc++ -isystem $LIBCXX_HDR -isystem $B1NIX_INC"
  fi
else
  if [ -d "$MUSL_INC" ]; then
    EXTRA_FLAGS="-nostdinc -isystem $CLANG_INC -isystem $MUSL_INC -idirafter $B1NIX_INC"
  else
    EXTRA_FLAGS="-nostdinc -isystem $CLANG_INC -isystem $B1NIX_INC"
  fi
fi

if [ "$IS_LINK" -eq 1 ]; then
  EXTRA_FLAGS="$EXTRA_FLAGS -fuse-ld=lld -Wl,--sysroot=$CROSS"
fi

# shellcheck disable=SC2086
exec "$real" $EXTRA_FLAGS "$@"
