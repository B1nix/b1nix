#!/bin/sh
# Cross-compiler wrapper for autotools-style userspace ports.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
USR="$PROJECT_DIR/userspace"
INCLUDE="$USR/include"
B1NIX_ARCH="${B1NIX_ARCH:-x86_64}"
if [ "$B1NIX_ARCH" = "x86" ]; then
	TARGET="i686-unknown-elf"
	LD_EMULATION="elf_i386"
	ARCH_FLAGS="-fomit-frame-pointer"
else
	TARGET="x86_64-unknown-elf"
	LD_EMULATION="elf_x86_64"
	ARCH_FLAGS=""
fi
LIB="$USR/build/$B1NIX_ARCH/libb1nix.a"
CRT0="$USR/build/$B1NIX_ARCH/crt/crt0.o"
SHARED_LIBC="$USR/build/$B1NIX_ARCH/libc.so.1"
DYNAMIC_CRT0="$USR/build/$B1NIX_ARCH/crt/crt0-dynamic.o"
LINKER="$USR/linker.ld"
LD="$(command -v ld.lld 2>/dev/null || echo /opt/homebrew/bin/ld.lld)"

# Link model. B1NIX_LINK=dynamic links the final executable DYNAMICALLY against
# the shared libc.so.1 via the in-kernel loader (interpreter /lib/ld-b1nix.so):
# the result is a dynamically-linked ET_EXEC that imports libc as undefined
# symbols (COPY relocs for stdout/stderr/errno, JUMP_SLOTs for the functions),
# while the port's own objects and any bundled static archives stay statically
# linked at the fixed 0x2000000 base (non-PIE, so no -fPIC needed). Library
# (compile-only / -c) invocations are unaffected — only the link step changes.
# Default stays `static` so unconverted ports are byte-for-byte unchanged.
B1NIX_LINK="${B1NIX_LINK:-static}"

if [ "$B1NIX_LINK" = "dynamic" ]; then
  [ -f "$SHARED_LIBC" ] && [ -f "$DYNAMIC_CRT0" ] ||
    make B1NIX_ARCH="$B1NIX_ARCH" -C "$USR" -s "$SHARED_LIBC" "$DYNAMIC_CRT0"
fi
[ -f "$LIB" ] && [ -f "$CRT0" ] || make B1NIX_ARCH="$B1NIX_ARCH" -C "$USR" -s "$LIB" "$CRT0"

CLANG_RES_DIR="$(clang -print-resource-dir 2>/dev/null || true)"
if [ -n "$CLANG_RES_DIR" ]; then
	RES_INC="-isystem $CLANG_RES_DIR/include"
else
	RES_INC=""
fi

COMMON_FLAGS="--target=$TARGET $ARCH_FLAGS -ffreestanding -fno-builtin -fno-stack-protector -nostdinc -isystem $INCLUDE -I $INCLUDE $RES_INC -Wall -Wextra -O2 -msoft-float -mno-implicit-float -Db1nix -D__STDC_NO_ATOMICS__"
# Ported code (libffi, libidn2, etc.) often uses memcpy/memset without
# including <string.h>. Provide it automatically for C files only — not for
# assembly (.S), which b1nix's string.h (containing inline asm) would confuse.
C_ONLY_FLAGS="-include string.h"

compile_only=0
preprocess_only=0
output=""
args=""
inputs=""
ldargs=""

while [ $# -gt 0 ]; do
  case "$1" in
    -c)
      compile_only=1
      ;;
    -E)
      preprocess_only=1
      args="$args -E"
      ;;
    -o)
      shift
      output="$1"
      ;;
    -MT|-MF|-MQ|-isystem|-I|-L|-D|-U|-x)
      args="$args $1 $2"
      shift
      ;;
    *.c|*.S|*.s|*.o|*.a)
      inputs="$inputs $1"
      ;;
    -lpthread|-lc|-lm|-lrt|-ldl|-lutil|-lcrypt|-lresolv|-lnsl)
      # These are all provided by libb1nix.a (always whole-archived below), so
      # there is no standalone lib<name>.a to find. Drop them — otherwise a port
      # configured with --enable-threads (gnulib emits -lpthread) or that links
      # -lrt/-ldl fails at ld with "unable to find -lX".
      ;;
    -l*|-L*)
      ldargs="$ldargs $1"
      ;;
    *)
      args="$args $1"
      ;;
  esac
  shift
done

if [ "$preprocess_only" -eq 1 ]; then
  exec clang $COMMON_FLAGS $args $inputs ${output:+-o "$output"}
fi

if [ "$compile_only" -eq 1 ]; then
  exec clang $COMMON_FLAGS $args -c $inputs ${output:+-o "$output"}
fi

# Version/info probes (e.g. `CC --version`, `-dumpmachine`) carry no input
# files. Forward them straight to clang instead of trying to link crt0.o,
# which would fail with "undefined symbol: main" and confuse configure.
if [ -z "$inputs" ]; then
  exec clang $COMMON_FLAGS $args ${output:+-o "$output"}
fi

objs=""
tmpdir="${TMPDIR:-/tmp}/b1nix-autotools-cc.$$"
mkdir -p "$tmpdir"
for input in $inputs; do
  case "$input" in
    *.o|*.a)
      objs="$objs $input"
      ;;
    *)
      obj="$tmpdir/$(basename "$input").o"
      extra=""
      case "$input" in *.c) extra="$C_ONLY_FLAGS";; esac
      clang $COMMON_FLAGS $extra $args -c "$input" -o "$obj"
      objs="$objs $obj"
      ;;
  esac
done

[ -n "$output" ] || output="a.out"
# Optional extra linker flags (opt-in via env; empty by default so existing
# ports are unaffected). bash, for instance, ships its own getenv/setenv set
# that intentionally shadows libb1nix's, needing --allow-multiple-definition.
if [ "$B1NIX_LINK" = "dynamic" ]; then
  # Dynamically-linked ET_EXEC against the shared libc.so.1. crt0-dynamic.o
  # reaches `environ` through the GOT and skips libgcc eh-frame registration, so
  # there is no canonical-PLT-to-0 trap. The port's bundled static archives
  # ($objs / $ldargs) link normally; only libc becomes a shared dependency.
  "$LD" -m "$LD_EMULATION" -T "$LINKER" --dynamic-linker /lib/ld-b1nix.so \
    -z norelro --hash-style=sysv -o "$output" "$DYNAMIC_CRT0" $objs $ldargs \
    ${B1NIX_LD_EXTRA:-} "$SHARED_LIBC"
else
  "$LD" -m "$LD_EMULATION" -T "$LINKER" -o "$output" "$CRT0" $objs $ldargs ${B1NIX_LD_EXTRA:-} --whole-archive "$LIB" --no-whole-archive
fi
