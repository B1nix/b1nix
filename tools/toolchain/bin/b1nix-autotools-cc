#!/usr/bin/env bash
# Cross-compiler wrapper for autotools-style userspace ports.
set -e

# Resolve the symlink itself (not just dirname-of-invocation-path) before
# walking up. `build/` is a symlink to another mount; when this wrapper is
# invoked via a RELATIVE path (as ninja/GN do) the process's physical cwd is
# already resolved onto that other mount, so a naive dirname-of-$0 walk-up
# never reaches the project root. Following the symlink chain of $0 lands on
# the real tools/toolchain/bin/b1nix-autotools-cc under the project root
# regardless of how/where the wrapper was invoked from.
SELF="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PROJECT_DIR=""
cur="$SCRIPT_DIR"
while [ "$cur" != "/" ]; do
  if [ -f "$cur/Makefile" ] && [ -d "$cur/kernel" ]; then
    PROJECT_DIR="$cur"
    break
  fi
  cur="$(dirname "$cur")"
done
if [ -z "$PROJECT_DIR" ]; then
  echo "b1nix-autotools-cc: cannot find project root" >&2
  exit 1
fi
USR="$PROJECT_DIR/userspace"
INCLUDE="$USR/include"
B1NIX_ARCH="${B1NIX_ARCH:-x86_64}"
if [ "$B1NIX_ARCH" = "x86" ]; then
	TARGET="i686-unknown-elf"
	LD_EMULATION="elf_i386"
	ARCH_FLAGS="-fomit-frame-pointer"
else
	TARGET="x86_64-unknown-elf"
	LD_EMULATION="elf_x86_64"
	ARCH_FLAGS=""
fi

if [ "$B1NIX_ARCH" = "x86" ]; then
	TRIPLET="i686-b1nix"
else
	TRIPLET="x86_64-b1nix"
fi
MUSL_INCLUDE="$PROJECT_DIR/build/x86_64/ports/musl/install/include"

# Intercept GCC-specific query flags
for arg in "$@"; do
  case "$arg" in
    --version|-dumpversion|-dumpmachine)
      exec clang --target="$TARGET" "$@"
      ;;
  esac
  if [ "$arg" = "-print-sysroot" ]; then
    echo "$PROJECT_DIR/build/x86_64/toolchain/$TRIPLET/cross/$TRIPLET"
    exit 0
  fi
done

SHARED_LIBC="$USR/build/$B1NIX_ARCH/libc.so.1"
# musl static-link objects (M92): a caller-requested -static link (Rust's ET_EXEC
# targets, crt-static-default) must use musl's own crt1/crti/crtn + libc.a, not
# the retired in-house libb1nix.a/crt0.o — those Makefile targets no longer
# exist post-musl-migration ("No rule to make target 'build/x86_64/libb1nix.a'").
MUSL_LIB_DIR="$PROJECT_DIR/build/$B1NIX_ARCH/ports/musl/install/lib"
MUSL_CRT1="$MUSL_LIB_DIR/crt1.o"
MUSL_CRTI="$MUSL_LIB_DIR/crti.o"
MUSL_CRTN="$MUSL_LIB_DIR/crtn.o"
MUSL_LIBA="$MUSL_LIB_DIR/libc.a"
MUSL_SCRT1="$MUSL_LIB_DIR/Scrt1.o"
MUSL_SO="$MUSL_LIB_DIR/libc.so"
# Relative target paths for the on-demand `make -C "$USR"` calls below: the
# userspace Makefile defines its rules relative to build/$(B1NIX_ARCH)/... , so
# `make` must be handed the RELATIVE target, not the absolute path (an absolute
# path matches no rule → "No rule to make target"). Triggered on a clean build
# when a port's configure runs the compiler before libc.so.1 has been built.
REL_SHARED_LIBC="build/$B1NIX_ARCH/libc.so.1"
REL_DYNAMIC_CRT0="build/$B1NIX_ARCH/crt/crt0-dynamic.o"
# Default linker script is the plain C one. C++ ports that fold libc++/libjxl and
# KEEPs .eh_frame/.eh_frame_hdr/.gcc_except_table + the .ctors.* static-init glob)
# and pass --eh-frame-hdr via B1NIX_LD_EXTRA — otherwise C++ unwinding is dead
# (e.g. NetSurf's libjxl decode silently fails). See tools/ports/build-netsurf-fb.sh.
LD="$(command -v ld.lld 2>/dev/null || echo /opt/homebrew/bin/ld.lld)"
CLANG="${B1NIX_CLANG:-$(command -v /opt/homebrew/opt/llvm/bin/clang 2>/dev/null || command -v clang)}"
if [ "${B1NIX_NO_CCACHE:-0}" != "1" ] && command -v ccache >/dev/null 2>&1; then
	CLANG="ccache $CLANG"
fi

# Passthrough cases: the caller controls the entire link, so injecting b1nix's own
# crt0/libc/-T would be wrong (a second _start, or crt0's _start pulling `main`
# into an object that has none). Pass the command straight through to clang,
# preserving the caller's EXACT argument order. --target keeps the ELF arch
# correct. Cases:
#   -nostdlib         a port's build may supply its own crt0.o/libc++/libb1nix.a/-T.
#   -r / --relocatable / -Wl,-r
#                     Partial (relocatable) link, e.g. busybox's applets/built-in.o
#                     — no startup files and no `main` expected.
# (Before M90, x86_64-b1nix-gcc was real GCC, which never injected startup files
# for these, so this passthrough restores the historical behaviour.)
for _a in "$@"; do
	case "$_a" in
	-r|--relocatable|-Wl,-r|-Wl,--relocatable)
		# Clang on macOS delegates unknown-OS ELF links to the host gcc driver,
		# which injects Darwin flags (-arch/-platform_version). A relocatable
		# link needs no compiler driver at all, so invoke target ld.lld directly.
		# Remove only compiler-driver runtime switches; they have no ld meaning.
		r_args=()
		for _rarg in "$@"; do
			case "$_rarg" in
			-rtlib=*|-unwindlib=*|-static-libgcc) continue ;;
			esac
			r_args+=("$_rarg")
		done
		exec "$LD" -m "$LD_EMULATION" "${r_args[@]}"
		;;
	esac
done

B1NIX_LINK="${B1NIX_LINK:-dynamic}"
# Compiler and preprocessor probes do not need b1nix startup objects or a
# libc link target.  In particular, Meson invokes the wrapper with -E -dM
# before the musl userspace runtime has been installed.
B1NIX_NO_RUNTIME=0
for _a in "$@"; do
  case "$_a" in
  -c|-E|-nostdlib) B1NIX_NO_RUNTIME=1 ;;
  esac
done
# Honor a caller-requested static link (e.g. Rust's static ET_EXEC targets pass
# `-static -no-pie`). Pre-M90 x86_64-b1nix-gcc was real GCC and honored -static;
# the wrapper must too, otherwise a `-static` link silently produces a dynamic
# ELF (with --dynamic-linker + shared libc.so.1) that the caller never expects.
for _a in "$@"; do
  case "$_a" in
  -static) B1NIX_LINK=static ;;
  esac
done

# Building a shared object (.so)? Rust emits `-shared -Wl,-soname=...` for every
# dylib crate-type (libstd.so, librustc_driver.so under -Cprefer-dynamic). A .so
# is position-independent, has NO _start/crt0, and must NOT use the executable
# linker script (fixed load base 0x2000000) — so it takes a dedicated ld path.
is_shared=0
for _a in "$@"; do
  case "$_a" in
  -shared) is_shared=1 ;;
  esac
done

# The retired b1nix shared libc.so.1/crt0-dynamic.o have no Makefile rule
# post-musl-migration; only attempt the on-demand build when musl's own PIE
# dynamic objects (Scrt1.o/libc.so, from build-musl.sh) are not already there.
if [ "$B1NIX_NO_RUNTIME" -eq 0 ] && [ "$B1NIX_LINK" = "dynamic" ] &&
   { [ ! -f "$MUSL_SCRT1" ] || [ ! -f "$MUSL_SO" ]; }; then
  [ -f "$SHARED_LIBC" ] && [ -f "$DYNAMIC_CRT0" ] ||
    make B1NIX_ARCH="$B1NIX_ARCH" -C "$USR" -s "$REL_SHARED_LIBC" "$REL_DYNAMIC_CRT0"
fi

CLANG_RES_DIR="$(clang -print-resource-dir 2>/dev/null || true)"
if [ -n "$CLANG_RES_DIR" ]; then
	RES_INC="-isystem $CLANG_RES_DIR/include"
else
	RES_INC=""
fi

cflags=("--target=$TARGET")
if [ -n "$ARCH_FLAGS" ]; then
  cflags+=("$ARCH_FLAGS")
fi
cflags+=("-ffreestanding" "-fno-builtin" "-fno-stack-protector" "-nostdinc")
if [ -d "$MUSL_INCLUDE" ]; then
  cflags+=("-isystem" "$MUSL_INCLUDE" "-idirafter" "$INCLUDE")
else
  cflags+=("-isystem" "$INCLUDE" "-I" "$INCLUDE")
fi
if [ -n "$RES_INC" ]; then
  cflags+=($RES_INC)
fi
cflags+=("-Wall" "-Wextra" "-O2" "-msoft-float" "-mno-implicit-float" "-Db1nix" "-D__b1nix__" "-D__unix__" "-D__STDC_NO_ATOMICS__")

C_ONLY_FLAGS=("-include" "string.h")

compile_only=0
preprocess_only=0
passthrough_link=0
output=""
# sources[]  — .c/.s/.S files this wrapper must compile.
# linkline[] — every link token (.o/.a, -l, -L, and -Wl,-translated) IN ORDER.
#   Ordering is preserved on purpose: --whole-archive / --start-group / -Bstatic
#   must wrap exactly the libraries they precede. Real GCC (the pre-M90
#   x86_64-b1nix-gcc) forwarded -Wl,* to ld in place; the wrapper must do the same
#   or complex links silently lose them — e.g. NetSurf loses its libnsfb surface
#   backends (empty .init_array → "Unknown surface") and its folded static libc++.
# args[]     — compile-only flags (includes/defines), never passed to the linker.
sources=()
args=()
linkline=()

while [ $# -gt 0 ]; do
  case "$1" in
    -c)
      compile_only=1
      ;;
    -E)
      preprocess_only=1
      args+=("-E")
      ;;
    -nostdlib)
      # The caller supplies crt0, libraries and linker script. Keep the
      # wrapper's direct ld.lld path, but do not inject another startup/libc.
      passthrough_link=1
      ;;
    -o)
      shift
      output="$1"
      ;;
    -MT|-MF|-MQ|-isystem|-I|-D|-U|-x)
      args+=("$1" "$2")
      shift
      ;;
    -Wl,*)
      # Translate the GCC-driver -Wl,a,b,c form into ld args a b c, appended in
      # place so grouping directives stay attached to their libraries. MUST be
      # handled BEFORE the file-name globs below: a -Wl option whose VALUE ends
      # in .so (e.g. -Wl,-soname=libstd-XXXX.so, emitted for every Rust dylib)
      # would otherwise match the `*.so` input glob and reach ld.lld verbatim as
      # an unknown `-Wl,-soname=...` argument.
      IFS=',' read -ra _wlparts <<<"${1#-Wl,}"
      linkline+=("${_wlparts[@]}")
      ;;
    -L)
      linkline+=("-L" "$2")
      shift
      ;;
    *.c|*.S|*.s)
      sources+=("$1")
      ;;
    *.o|*.a|*.rlib|*.so|*.so.[0-9]*)
      # .rlib: Rust compilation units (Rust passes each rlib as a plain file arg,
      # like GCC did). .so/.so.N: shared objects passed positionally. All are
      # ordinary link inputs and must go on the link line in order.
      linkline+=("$1")
      ;;
    -lpthread|-lc|-lm|-lrt|-ldl|-lutil|-lcrypt|-lresolv|-lnsl)
      ;;
    -lstdc++)
      # GCC-free redirect: Rust's rustc_llvm crate hard-links -lstdc++ for the
      # LLVM C++ wrapper. b1nix ships NO GCC libstdc++.so.6 (M89 → all C++ is
      # LLVM libc++), so route it to libc++/libc++abi — librustc_driver.so then
      # records DT_NEEDED libc++.so.1 / libc++abi.so.1 instead of libstdc++.so.6.
      linkline+=("-lc++" "-lc++abi")
      ;;
    -l*|-L*)
      linkline+=("$1")
      ;;
    *)
      args+=("$1")
      ;;
  esac
  shift
done

if [ "$preprocess_only" -eq 1 ]; then
  exec $CLANG "${cflags[@]}" "${args[@]}" "${sources[@]}" ${output:+-o "$output"}
fi

if [ "$compile_only" -eq 1 ]; then
  exec $CLANG "${cflags[@]}" "${args[@]}" -c "${sources[@]}" ${output:+-o "$output"}
fi

if [ ${#sources[@]} -eq 0 ] && [ ${#linkline[@]} -eq 0 ]; then
  exec $CLANG "${cflags[@]}" "${args[@]}" ${output:+-o "$output"}
fi

objs=()
tmpdir="${TMPDIR:-/tmp}/b1nix-autotools-cc.$$"
mkdir -p "$tmpdir"
for input in "${sources[@]}"; do
  obj="$tmpdir/$(basename "$input").o"
  extra=()
  case "$input" in *.c) extra=("${C_ONLY_FLAGS[@]}");; esac
  $CLANG "${cflags[@]}" "${extra[@]}" "${args[@]}" -c "$input" -o "$obj"
  objs+=("$obj")
done

[ -n "$output" ] || output="a.out"
# Default library search paths so plain `-l` names (e.g. the LLVM runtimes
# -lunwind / -lcompiler_rt the Rust target spec links) resolve without the
# caller having to pass an absolute -L: the cross sysroot lib dir and the
# per-target cross lib dir. Caller -L entries in linkline[] still take priority.
# Prefer the flat per-arch layout (build/x86_64/toolchain/{sysroot,cross/...})
# that env.sh/build-toolchain.sh actually populate; fall back to the older
# triplet-nested tree for any build that still has one.
# sysroot/usr/lib (not the bare sysroot/lib, which build-llvm-runtimes.sh's
# standalone libunwind build leaves incomplete — missing the register
# save/restore assembly) is where build-libcxx.sh installs the AUTHORITATIVE
# libunwind.a. See its "Install into cross sysroot" step.
SYSROOT_LIB="$(ls -d "$PROJECT_DIR/build/x86_64/toolchain/sysroot/usr/lib" "$PROJECT_DIR/build/x86_64/toolchain/$TRIPLET/sysroot/usr/lib" 2>/dev/null | head -1)"
CROSS_LIB="$(ls -d "$PROJECT_DIR/build/x86_64/toolchain/cross/$TRIPLET/lib" "$PROJECT_DIR/build/x86_64/toolchain/$TRIPLET/cross/$TRIPLET/lib" 2>/dev/null | head -1)"
libdirs=()
[ -d "$SYSROOT_LIB" ] && libdirs+=("-L" "$SYSROOT_LIB")
[ -d "$CROSS_LIB" ] && libdirs+=("-L" "$CROSS_LIB")
runtime_libs=()
# This wrapper invokes ld.lld directly, so clang cannot inject its normal
# compiler-rt runtime automatically. Add the LLVM builtins explicitly; without
# this, configure probes for 64-bit atomics fail even though clang emitted the
# correct atomic instructions/calls.
[ -f "$CROSS_LIB/libcompiler_rt.a" ] && runtime_libs+=("$CROSS_LIB/libcompiler_rt.a")

if [ "$passthrough_link" -eq 1 ]; then
  exec "$LD" -m "$LD_EMULATION" -o "$output" \
    "${objs[@]}" "${libdirs[@]}" "${linkline[@]}" "${runtime_libs[@]}" \
    ${B1NIX_LD_EXTRA:-}
fi
if [ "$is_shared" -eq 1 ]; then
  # Shared object: PIC, no crt0, no executable linker script, no --whole-archive
  # libb1nix. -soname/--version-script/--export-dynamic etc. already arrived via
  # the translated linkline[]. libc symbols resolve from the shared libc.so.1
  # (records DT_NEEDED libc.so.1); the LLVM libunwind that -lgcc_s routes to (see
  # the sysroot libgcc_s.so linker script) supplies the _Unwind_* ABI.
  #
  # A rust dylib that folds C++ code (librustc_driver.so pulls libLLVM's C++
  # wrapper objects → std::__1::* libc++ refs) must record DT_NEEDED libc++.so.1
  # / libc++abi.so.1, otherwise the downstream rustc EXE link (which passes
  # --no-allow-shlib-undefined) cannot satisfy the .so's undefined libc++
  # symbols. Link them --as-needed so a pure-Rust .so (libstd.so, no C++) does
  # NOT gain a spurious libc++ dependency.
  cxx_shared=()
  if [ -f "$SYSROOT_LIB/libc++.so.1" ] && [ -f "$SYSROOT_LIB/libc++abi.so.1" ]; then
    cxx_shared=(--push-state --as-needed "$SYSROOT_LIB/libc++.so.1" "$SYSROOT_LIB/libc++abi.so.1" --pop-state)
  fi
  exec "$LD" -m "$LD_EMULATION" -shared --hash-style=sysv -o "$output" \
    "${objs[@]}" "${libdirs[@]}" "${linkline[@]}" "${runtime_libs[@]}" ${B1NIX_LD_EXTRA:-} "${cxx_shared[@]}" "$SHARED_LIBC"
elif [ "$B1NIX_LINK" = "dynamic" ] && [ -f "$MUSL_SCRT1" ] && [ -f "$MUSL_SO" ]; then
  # musl PIE/ET_DYN dynamic link (M92): the retired b1nix shared libc.so.1 +
  # crt0-dynamic.o have no Makefile rule anymore, so route through musl's own
  # Scrt1.o/libc.so instead — same DT_NEEDED-by-basename trick b1nix-musl-cc
  # uses (a same-named symlink so the recorded NEEDED entry is the bare
  # "ld-musl-x86_64.so.1" the kernel actually searches for in /lib).
  musl_link_dir="${TMPDIR:-/tmp}/b1nix-autotools-musl-link.$$"
  mkdir -p "$musl_link_dir"
  ln -sf "$MUSL_SO" "$musl_link_dir/ld-musl-x86_64.so.1"
  "$LD" -m "$LD_EMULATION" -pie --dynamic-linker /lib/ld-musl-x86_64.so.1 \
    --hash-style=sysv -o "$output" "$MUSL_SCRT1" "$MUSL_CRTI" \
    "${objs[@]}" "${libdirs[@]}" "${linkline[@]}" "${runtime_libs[@]}" \
    ${B1NIX_LD_EXTRA:-} -L"$musl_link_dir" -l:ld-musl-x86_64.so.1 "$MUSL_CRTN"
  ld_status=$?
  rm -rf "$musl_link_dir"
  if [ "$ld_status" -eq 0 ]; then
    # Mark ELFOSABI_LINUX (3) so the kernel routes syscalls through the Linux
    # ABI translation layer, matching every other musl-linked b1nix binary.
    python3 -c "
import sys
f = sys.argv[1]
with open(f, 'r+b') as fh:
    fh.seek(7)
    fh.write(bytes([3]))
" "$output" 2>/dev/null || true
  fi
  exit "$ld_status"
else
  # Everything else used to fall back to a fixed-address static link (the old
  # b1nix libc.a/crt0.o, or musl's libc.a through userspace/linker.ld). Those
  # paths are gone: b1nix ships dynamic PIEs only, and tools/check-dynamic.sh
  # rejects a static executable in the rootfs anyway. Failing here is the point
  # — a caller that cannot link dynamically has a problem to fix, not a flag to
  # switch.
  echo "b1nix-autotools-cc: refusing to link '$output' statically." >&2
  echo "  b1nix links dynamically against /lib/libc.so; see the port scripts" >&2
  echo "  under tools/ports/ for the flags, and tools/configs/static-allowlist.txt" >&2
  echo "  for the (reasoned) exceptions." >&2
  if [ ! -f "$MUSL_SCRT1" ] || [ ! -f "$MUSL_SO" ]; then
    echo "  musl's Scrt1.o/libc.so are missing — run tools/ports/build-musl.sh." >&2
  fi
  exit 1
fi
