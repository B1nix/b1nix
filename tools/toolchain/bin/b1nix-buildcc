#!/bin/sh
# Build-side compiler wrapper for the native (host=b1nix) GCC build.
#
# GCC's build-side helpers (build-libcpp, gen* generators) run on the BUILD
# machine during the build and must compile with NORMAL host flags. GCC leaks
# the *target* CXXFLAGS into them, so the compiler is invoked with
# --sysroot=<b1nix>, -idirafter <b1nix>/include and -Wl,-Ttext-segment=... —
# redirecting header search into the b1nix sysroot (no host bits/wordsize.h
# there) and failing.
#
# Strip those target-only flags and forward the rest to the real build compiler
# ($B1NIX_BUILD_REAL, e.g. gcc or g++). Argument boundaries are preserved with
# `set --` (a naive string accumulation would mangle quoted -D"..." defines).
set -u
real="${B1NIX_BUILD_REAL:-gcc}"
if [ "${B1NIX_NO_CCACHE:-0}" != "1" ] && command -v ccache >/dev/null 2>&1; then
  set -- "$real" "$@"
  real=ccache
fi
n=$#
skip=0
while [ "$n" -gt 0 ]; do
  a="$1"; shift; n=$((n - 1))
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case "$a" in
    --sysroot=*) ;;          # target sysroot
    -idirafter)  skip=1 ;;   # drops "-idirafter <b1nix>/include"
    -Wl,*) ;;                # target link layout (text-segment / multiple-def)
    *) set -- "$@" "$a" ;;   # keep, preserving the exact argument
  esac
done
exec "$real" "$@"
