#!/bin/sh
# b1nix-cc — Cross-compiler wrapper for B1NIX userspace
# Usage: b1nix-cc source.c -o output

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
USR="$PROJECT_DIR/userspace"
INCLUDE="$USR/include"
B1NIX_ARCH="${B1NIX_ARCH:-x86_64}"
if [ "$B1NIX_ARCH" = "x86" ]; then
	TARGET="i686-unknown-elf"
	LD_EMULATION="elf_i386"
	ARCH_FLAGS="-fomit-frame-pointer"
else
	TARGET="x86_64-unknown-elf"
	LD_EMULATION="elf_x86_64"
	ARCH_FLAGS=""
fi
LIB="$USR/build/$B1NIX_ARCH/libb1nix.a"
CRT0="$USR/build/$B1NIX_ARCH/crt/crt0.o"
LINKER="$USR/linker.ld"
LD="$(command -v ld.lld 2>/dev/null || echo /opt/homebrew/bin/ld.lld)"
CLANG=clang
if [ "${B1NIX_NO_CCACHE:-0}" != "1" ] && command -v ccache >/dev/null 2>&1; then
	CLANG="ccache clang"
fi

[ -f "$LIB" ] && [ -f "$CRT0" ] || {
	echo "b1nix-cc: building libc..." >&2
	# Make targets are relative to userspace/Makefile. Passing the absolute
	# paths above made a clean build fail with "No rule to make target".
	make -C "$USR" B1NIX_ARCH="$B1NIX_ARCH" -s \
		"build/$B1NIX_ARCH/libb1nix.a" "build/$B1NIX_ARCH/crt/crt0.o"
}

# Parse: find sources, output, and keep other flags
OUTPUT="a.out"
SOURCES=""
FLAGS=""
LINK_FLAGS=""
while [ $# -gt 0 ]; do
	case "$1" in
		-o) shift; OUTPUT="$1" ;;
		-c) ;;  # skip -c
		-lm) LINK_FLAGS="$LINK_FLAGS $PROJECT_DIR/build/${B1NIX_ARCH}/ports/openlibm/install/lib/libm.a" ;;
		-*) FLAGS="$FLAGS $1" ;;
		*) SOURCES="$SOURCES $1" ;;
	esac
	shift
done

CLANG_RES_DIR="$(clang -print-resource-dir 2>/dev/null || true)"
if [ -n "$CLANG_RES_DIR" ]; then
	RES_INC="-isystem $CLANG_RES_DIR/include"
else
	RES_INC=""
fi

OBJS=""
for src in $SOURCES; do
	obj="${src%.c}.o"
	# shellcheck disable=SC2086
	$CLANG --target="$TARGET" $ARCH_FLAGS -ffreestanding -fno-builtin -fno-stack-protector \
		-nostdinc -isystem "$INCLUDE" -I "$INCLUDE" $RES_INC -Wall -O2 -msoft-float -mno-implicit-float -Db1nix $FLAGS -c "$src" -o "$obj"
	OBJS="$OBJS $obj"
done

# shellcheck disable=SC2086
"$LD" -m "$LD_EMULATION" -T "$LINKER" -o "$OUTPUT" "$CRT0" $OBJS --whole-archive "$LIB" --no-whole-archive $LINK_FLAGS
echo "b1nix-cc: $OUTPUT ready" >&2
