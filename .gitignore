# The build tree, and only the one at the top: an unanchored "build" also
# ignored tools/toolchain, so a script added there silently never reached the
# repository -- and the ones already tracked had to have been forced in.
/build
/build/
.DS_Store
logs/
.tmp/
smoke_run/
.claude/
CLAUDE.md

# codebase-memory MCP local index artifact (regenerable, machine-local).
/.codebase-memory/
/docs/agent-memory

/scratch




AGENTS.md
/.mimocode
/graphify-out

# Board firmware & binaries
*.uf2
*.bin
*.elf
*.hex
*.img
tests/support/linux-abi/
tools/board/rp2350/bin/
tools/board/rp2350/build-*/
tools/board/rp2350/pico-sdk/



# ── Android / LineageOS device tree ──────────────────────────────────────────
# Extracted vendor blobs: ~800 MB of proprietary Sony/Qualcomm binaries that
# belong on the device, not in this history. Regenerate them from a running
# phone with device/sony/bahamut/extract-files.sh.
tools/board/sony-xperia-5/android_device_tree/vendor/
tools/board/sony-xperia-5/android_device_tree/**/proprietary/

# AOSP/LineageOS build trees and output (hundreds of GB, all regenerable).
/.repo/
/out/
tools/board/sony-xperia-5/out/
tools/board/sony-xperia-5/lineage/

# Intermediate device-tree blobs kept only while splitting a multi-SoC bundle.
*.dtb.orig

# The Xperia 5 device tree ships as tools/board/sony-xperia-5/android_device_tree.tar.gz.
# The unpacked copy also holds ~810 MiB of vendor blobs that are not ours to carry.
tools/board/sony-xperia-5/android_device_tree/
tests/.smoke-frozen.sh
/.vscode
*.o
