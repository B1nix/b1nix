#!/bin/sh
# bpkg - minimal package manager for b1nix.
#
# A thin POSIX-sh wrapper over tools that already ship in b1nix: curl (HTTPS via
# libcurl+mbedTLS, and file://), busybox tar/gzip/sha256sum, ext4 rw. No daemon,
# no JSON, no database - just a flat-text index and per-package metadata files.
#
# Index format: one package per line, '#' comments allowed, space-separated:
#   name  version  arch  sha256(64-hex)  url  [deps]
# The 6th 'deps' field is OPTIONAL (comma-separated package names) and
# backward-compatible: legacy 5-field lines parse exactly as before.
#
# Dependencies are installed transitively before the package, cycle-safe and
# skipping anything already installed.
# ponytail: deps are name-only (no version constraints) - the index pins one
#   version per (name,arch), so a bare name is unambiguous.
# ponytail: GPG/signature verification omitted - sha256 in a trusted index is the
#   integrity boundary. Upgrade path: detached .sig + minisign/gpg verify.
# ponytail: version rollback / hold / autoremove omitted. Upgrade path: keep old
#   tarballs in a cache dir and add install --version / a hold flag file.

set -u

ROOT="${ROOT:-/}"
case "$ROOT" in /) PREFIX= ;; */) PREFIX="${ROOT%/}" ;; *) PREFIX="$ROOT" ;; esac
CONF="$PREFIX/etc/bpkg.conf"
STATE="$PREFIX/var/lib/bpkg"
INDEX="$STATE/index"
INSTALLED="$STATE/installed"

# Default, overridable by /etc/bpkg.conf
INDEX_URL="file:///pkgs/index"
[ -f "$CONF" ] && . "$CONF"

# busybox provides tar / gzip / sha256sum; call it explicitly so this works even
# without /bin symlinks for those applets.
BB=/opt/busybox/bin/busybox

err() { echo "bpkg: $*" >&2; }

usage() {
	cat >&2 <<EOF
usage: bpkg <command> [args]
  update            fetch the package index from INDEX_URL
  install <name>    install a package + its deps (verifies sha256)
  install-all       install every package for this architecture
  remove <name>     remove an installed package
  list              list installed packages
  search <pattern>  search the index
EOF
	exit 2
}

need_index() {
	if [ ! -f "$INDEX" ]; then
		err "no package index; run 'bpkg update' first"
		exit 1
	fi
}

# Find the index line matching $1 (name) AND the running arch. Prints the
# normalized line 'name ver arch sha url deps' (deps='-' when absent), or
# returns non-zero if no match. Skips blank/comment lines. The optional 6th
# 'deps' field is comma-separated package names.
find_pkg() {
	name="$1"
	arch="$(uname -m)"
	while read -r f_name f_ver f_arch f_sha f_url f_deps _rest; do
		case "$f_name" in ''|\#*) continue ;; esac
		[ "$f_name" = "$name" ] || continue
		[ "$f_arch" = "$arch" ] || continue
		if [ -z "$f_ver" ] || [ -z "$f_arch" ] || [ -z "$f_sha" ] || [ -z "$f_url" ]; then
			err "malformed index line for '$name'"
			return 2
		fi
		# deps absent on legacy 5-field lines -> emit '-' as a placeholder so
		# the field count is stable for callers using positional parsing.
		[ -n "$f_deps" ] || f_deps=-
		echo "$f_name $f_ver $f_arch $f_sha $f_url $f_deps"
		return 0
	done < "$INDEX"
	return 1
}

cmd_update() {
	mkdir -p "$STATE"
	tmp="$STATE/.index.$$"
	if ! curl -fsSL "$INDEX_URL" -o "$tmp"; then
		err "failed to fetch index from $INDEX_URL"
		rm -f "$tmp"
		exit 1
	fi
	mv "$tmp" "$INDEX"
	echo "bpkg: index updated from $INDEX_URL"
}

# is_installed <name> -> 0 if the package already has recorded metadata.
is_installed() { [ -f "$INSTALLED/$1.ver" ]; }

# resolve_deps <name> <seen...> - print the transitive install order for
# <name> (its uninstalled deps first, deepest-first, then <name> itself), one
# package per line, de-duplicated. Cycle-safe via <seen> (the resolution
# stack). POSIX sh has no locals, so EACH recursive call is captured in $(...)
# - that isolates the child's clobbering of positionals/d_* from this frame.
resolve_deps() {
	d_name="$1"; shift; d_seen="$*"
	is_installed "$d_name" && return 0
	d_line="$(find_pkg "$d_name")" || { err "package '$d_name' not found for arch $(uname -m)"; exit 1; }
	# 6th field of the normalized line is deps ('-' when none).
	d_deps="${d_line##* }"
	d_out=
	if [ "$d_deps" != "-" ] && [ -n "$d_deps" ]; then
		old_ifs="$IFS"; IFS=','
		# shellcheck disable=SC2086
		set -- $d_deps
		IFS="$old_ifs"
		for dep in "$@"; do
			[ -n "$dep" ] || continue
			case " $d_seen $d_name " in *" $dep "*) continue ;; esac
			# Capture the child's order in a subshell so it cannot clobber
			# this frame's d_name / d_deps / positionals.
			sub="$(resolve_deps "$dep" $d_seen "$d_name")"
			d_out="$d_out$sub
"
		done
	fi
	# Emit deps (in order, de-duped against this frame) then the package itself.
	printf '%s' "$d_out" | while read -r p; do
		[ -n "$p" ] || continue
		echo "$p"
	done
	echo "$d_name"
}

# cmd_install <name> - resolve deps transitively, then install each package in
# dependency order (deps before dependents), skipping anything already present.
cmd_install() {
	[ $# -eq 1 ] || usage
	need_index
	if is_installed "$1"; then echo "bpkg: $1 already installed"; return 0; fi
	order="$(resolve_deps "$1")"
	for pkg in $order; do
		is_installed "$pkg" && continue
		[ "$pkg" = "$1" ] || echo "bpkg: $1 depends on $pkg"
		do_install "$pkg"
	done
}

# do_install <name> - fetch, verify sha256, extract, record metadata for a
# SINGLE package whose deps are already satisfied. No recursion happens here.
do_install() {
	name="$1"
	line="$(find_pkg "$name")"
	rc=$?
	if [ $rc -ne 0 ]; then
		err "package '$name' not found for arch $(uname -m)"
		exit 1
	fi
	# shellcheck disable=SC2086
	set -- $line
	p_name="$1"; p_ver="$2"; p_arch="$3"; p_sha="$4"; p_url="$5"

	mkdir -p "$INSTALLED"
	work="$STATE/.work.$$"
	rm -rf "$work"
	mkdir -p "$work"
	tarball="$work/pkg.tar.gz"

	if ! curl -fsSL "$p_url" -o "$tarball"; then
		err "failed to fetch $p_url"
		rm -rf "$work"
		exit 1
	fi

	# Integrity check - security boundary, never skipped. Compute the digest
	# and compare strings directly: busybox 'sha256sum -c' is unreliable here,
	# and 'cut' is not always present, so use POSIX parameter expansion.
	sum_out="$("$BB" sha256sum "$tarball")"
	got_sha="${sum_out%% *}"
	if [ -z "$got_sha" ] || [ "$got_sha" != "$p_sha" ]; then
		err "checksum mismatch for '$p_name' - refusing to install"
		err "expected $p_sha"
		err "got      $got_sha"
		rm -rf "$work"
		exit 1
	fi

	# Record the file list (member paths inside the tarball) before extracting.
	list="$INSTALLED/$p_name.list"
	if ! "$BB" tar -tzf "$tarball" > "$list" 2>/dev/null; then
		err "cannot read tarball contents for '$p_name'"
		rm -f "$list"
		rm -rf "$work"
		exit 1
	fi

	if ! "$BB" tar -xzf "$tarball" -C "$ROOT" 2>/dev/null; then
		err "extraction failed for '$p_name'"
		rm -f "$list"
		rm -rf "$work"
		exit 1
	fi

	echo "$p_ver" > "$INSTALLED/$p_name.ver"
	rm -rf "$work"
	echo "bpkg: installed $p_name $p_ver ($p_arch)"
}

cmd_remove() {
	[ $# -eq 1 ] || usage
	name="$1"
	list="$INSTALLED/$name.list"
	if [ ! -f "$list" ]; then
		err "package '$name' is not installed"
		exit 1
	fi
	# Remove files longest-path-first is unnecessary (we rm -f files, not dirs).
	while read -r path; do
		[ -n "$path" ] || continue
		# tar member paths are relative (e.g. "bin/hello"); anchor under ROOT.
		case "$path" in
			/*) target="$path" ;;
			*)  target="$ROOT/$path" ;;
		esac
		# Only remove files/symlinks, never directories (shared, may be system).
		[ -f "$target" ] || [ -L "$target" ] && rm -f "$target"
	done < "$list"
	rm -f "$list" "$INSTALLED/$name.ver"
	echo "bpkg: removed $name"
}

cmd_list() {
	if [ ! -d "$INSTALLED" ]; then
		return 0
	fi
	any=0
	for v in "$INSTALLED"/*.ver; do
		[ -f "$v" ] || continue
		n="$(basename "$v" .ver)"
		printf '%s %s\n' "$n" "$(cat "$v")"
		any=1
	done
	[ "$any" = 1 ] || echo "bpkg: no packages installed"
}

cmd_install_all() {
	need_index
	arch="$(uname -m)"
	while read -r name _version pkg_arch _sha _url _rest; do
		case "$name" in ''|\#*) continue ;; esac
		[ "$pkg_arch" = "$arch" ] || continue
		cmd_install "$name" || exit 1
	done < "$INDEX"
}

cmd_search() {
	[ $# -eq 1 ] || usage
	need_index
	# Ignore comments/blank lines; grep the rest.
	grep -v '^[[:space:]]*#' "$INDEX" | grep -v '^[[:space:]]*$' | grep -- "$1" || {
		err "no match for '$1'"
		exit 1
	}
}

[ $# -ge 1 ] || usage
sub="$1"; shift
case "$sub" in
	update)  cmd_update "$@" ;;
	install) cmd_install "$@" ;;
	install-all) cmd_install_all "$@" ;;
	remove)  cmd_remove "$@" ;;
	list)    cmd_list "$@" ;;
	search)  cmd_search "$@" ;;
	*)       usage ;;
esac
